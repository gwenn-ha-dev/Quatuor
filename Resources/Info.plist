<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The icon is Resources/AppIcon.icns, generated by outils/icone.swift and
	     copied into the bundle. Xcode's INFOPLIST_KEY_* settings do not cover
	     CFBundleIconFile — that key exists only for asset-catalogue icons — so
	     this file declares it. Everything else is still generated
	     (GENERATE_INFOPLIST_FILE) and merged on top. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
</dict>
</plist>
